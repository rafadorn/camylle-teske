# A conexão da Camy já está em supabase/public-config.json.
# Preencher o par abaixo apenas para substituir essa conexão em outro ambiente.
# Somente a URL do projeto e a chave PUBLICÁVEL (ou anon).
# Nunca use service_role / sb_secret_ como VITE_SUPABASE_PUBLISHABLE_KEY.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# / para domínio próprio; /camylle-teske/ para um site de projeto no GitHub Pages.
VITE_BASE_PATH=/
